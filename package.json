{
  "name": "playwrightautomation",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "regression": "npx playwright test",
    "webtesting": "npx playwright test --grep @web",
    "apitesting": "npx playwright test --grep @api",
    "originconfigtest": "npx playwright test --config playwright_orign.config.js",
    "CucumberFeaturesTest": "npx cucumber-js --retry 1 --exit --format html:playwright-report/cucumber-report.html",

    "master": "playwright test --grep @master",


    "test:sanity": "playwright test --grep @sanity",
    "test:regression": "playwright test --grep @regression",
    "test:datadriven": "playwright test --grep @datadriven",
    "test:master:headed": "playwright test --grep @master --headed",
    "test:sanity:debug": "playwright test --grep @sanity --debug",
    "test:opencart": "playwright test --grep @opencart",
    "test:ecart": "playwright test --grep @ecart",



    "test": "playwright test",
    "posttest": "allure generate ./allure-results -o ./allure-report --clean && allure open ./allure-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@azure/microsoft-playwright-testing": "^1.0.0-beta.7",
    "@cucumber/cucumber": "^11.1.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.10.1",
    "@zerostep/playwright": "^0.1.5",
    "allure-playwright": "^3.4.3"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@faker-js/faker": "^9.9.0",
    "csv-parse": "^6.1.0",
    "exceljs": "^4.4.0",
    "xlsx": "^0.18.5"
  }
}
